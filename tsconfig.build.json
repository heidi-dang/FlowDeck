{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/doctor",
    "src/orchestration/persistence/adapters/dev2-compatibility-check.ts",
    "src/**/__tests__/*",
    "src/**/*.test.ts"
  ]
}
