      "windows": "Expected canonical normalized input on Windows (null when filesystem- or cwd-dependent)."
    },
    "expected_id": {
      "posix": "Expected full project id `<name>-<8-hex-sha256>` on POSIX (null when not pinned).",
      "windows": "Expected full project id on Windows (null when not pinned)."
    },
    "slug_prefix": "Basename prefix asserted on every platform.",
    "different_from": "Entry ids that MUST produce a different id on every platform.",
    "create_dir": "When set, both implementations must create this relative dir under a temp root and produce identical ids (byte-for-byte TS/Rust parity on real directories).",
    "explanation": "Why this case matters."
  },
