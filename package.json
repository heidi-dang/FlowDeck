{
  "name": "@heidi-dang/flowdeck",
  "version": "0.8.0-alpha.1",
  "description": "FlowDeck — structured planning and execution workflows for OpenCode (Heidi fork)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "flowdeck": "./bin/flowdeck.js"
  },
  "files": [
    "dist",
    "bin",
    "scripts/config-mutator.mjs",
    "scripts/config-transaction.mjs",
    "scripts/doctor-engine.mjs",
    "src/commands",
    "src/rules",
    "src/skills",
    "docs",
    "postinstall.mjs",
    "install.sh",
    "uninstall.sh"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun build src/index.ts --outdir dist --target node --format esm --external @opencode-ai/plugin --external @opencode-ai/sdk && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "build:fdx": "cargo install --path crates/fdx --quiet",
    "check:fdx": "fdx --version",
    "postinstall": "node postinstall.mjs",
    "prepublishOnly": "bun run clean && bun run build",
    "test": "bun test",
    "test:coverage": "node scripts/check-coverage.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "verify:fast": "node scripts/pre-push.mjs --fast",
    "verify:full": "node scripts/pre-push.mjs --full",
    "doctor": "node -e \"import('./dist/index.js').catch(() => { console.log('Build required first: bun run build'); process.exit(1); })\""
  },
  "keywords": [
    "opencode",
    "plugin",
    "ai",
    "workflow",
    "planning",
    "heidi"
  ],
  "author": "Heidi Dang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heidi-dang/FlowDeck.git"
  },
  "bugs": {
    "url": "https://github.com/heidi-dang/FlowDeck/issues"
  },
  "homepage": "https://github.com/heidi-dang/FlowDeck#readme",
  "funding": "https://github.com/sponsors/heidi-dang",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "flowdeckFdxCompatibility": {
    "required": "^0.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "opencode": ">=1.4.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "bun-types": "^1.3.14",
    "ejs": "^6.0.1",
    "oxlint": "^1.75.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@opencode-ai/sdk": "^1.17.3"
  }
}
