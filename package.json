{
  "name": "@heidi-dang/flowdeck",
  "version": "1.0.4",
  "description": "FlowDeck — production-grade multi-agent orchestration, governance, CI repair, and code intelligence for OpenCode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "flowdeck": "./bin/flowdeck.js",
    "flowdeck-better-harness": "./bin/better-harness.js"
  },
  "files": [
    "dist",
    "bin",
    "scripts/config-mutator.mjs",
    "scripts/config-transaction.mjs",
    "scripts/doctor-engine.mjs",
    "scripts/doctor-service.mjs",
    "scripts/clean-install-engine.mjs",
    "scripts/release-alignment.mjs",
    "src/commands",
    "src/doctor/cli.mjs",
    "src/rules",
    "src/skills",
    "src/doctor",
    "docs",
    "postinstall.mjs",
    "install.sh",
    "!**/*.tmp.*",
    "!**/*.bak.*"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun build src/index.ts src/commands/fdx-admin.ts --outdir dist --target node --format esm --external @opencode-ai/plugin --external @opencode-ai/sdk --external jsonc-parser && tsc --emitDeclarationOnly --project tsconfig.build.json && bunx --yes esbuild src/doctor/doctor.ts --bundle --platform=node --format=esm --target=node18 --main-fields=module,main --outfile=dist/doctor/doctor.js && bun build src/better-harness/index.ts --outdir dist/better-harness --target node --format esm && bun build src/better-harness/ui/mount.ts --outdir dist/ui --target browser --format esm",
    "build:fdx": "cargo install --path crates/fdx --quiet",
    "check:fdx": "fdx --version",
    "postinstall": "node postinstall.mjs",
    "prepublishOnly": "bun run clean && bun run build",
    "test": "bun test --timeout 60000 --path-ignore-patterns=\"**/orchestration/persistence/**\"",
    "test:routing": "bun test tests/routing/ && node scripts/check-routing-policy-version.mjs",
    "test:routing:policy-version": "node scripts/check-routing-policy-version.mjs",
    "test:routing:classification": "bun test tests/routing/classification.test.ts",
    "test:routing:consistency": "bun test tests/routing/consistency.test.ts",
    "test:fdx-parity": "node scripts/verify-fdx-parity.mjs",
    "test:fdx-protocol": "bun test tests/fdx-protocol.test.ts",
    "test:fdx-daemon": "bun test tests/fdx-daemon.test.ts",
    "test:fdx-index": "bun test tests/fdx-index.test.ts",
    "test:fdx-index-incremental": "bun test tests/fdx-index.test.ts",
    "test:fdx-index-faults": "bun test tests/fdx-index-faults.test.ts",
    "benchmark:fdx": "node scripts/bench-fdx-baseline.mjs",
    "benchmark:fdx-index": "node scripts/bench-fdx-index.mjs",
    "test:coverage": "node scripts/check-coverage.mjs",
    "test:policy-version": "node scripts/check-routing-policy-version.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "verify:fast": "node scripts/pre-push.mjs --fast",
    "verify:full": "node scripts/pre-push.mjs --full",
    "verify:installation:offline": "node scripts/verify-opencode-integration.mjs --offline",
    "verify:installation": "node scripts/verify-opencode-integration.mjs",
    "verify:release": "node scripts/release-alignment.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:clean-install": "node bin/flowdeck.js clean-install --verify-only",
    "install:clean": "node bin/flowdeck.js clean-install",
    "better-harness:serve": "node bin/better-harness.js",
    "standalone:start": "bun run src/better-harness/testing/standalone-server-cli.ts",
    "doctor": "node -e \"import('./dist/index.js').catch(() => { console.log('Build required first: bun run build'); process.exit(1); })\"",
    "test:persistence": "bun src/orchestration/persistence/__tests__/run-tests.mjs && bun src/orchestration/persistence/__tests__/phase1-2-tests.mjs && bun src/orchestration/persistence/__tests__/phase1-3-tests.mjs && bun src/orchestration/persistence/__tests__/phase1-4-tests.mjs && bun src/orchestration/persistence/__tests__/phase1-5-retry.mjs",
    "test:persistence:node": "bun src/orchestration/persistence/__tests__/run-tests.mjs",
    "check:schema-generated": "node scripts/check-schema-generated.mjs",
    "generate:schema": "node -e \"const fs=require(\"fs\"),crypto=require(\"crypto\");const sql=fs.readFileSync(\"schema-v0.2.6.sql\",\"utf-8\");const c=crypto.createHash(\"sha256\").update(sql,\"utf-8\").digest(\"hex\");fs.writeFileSync(\"src/orchestration/persistence/migrations/schema-embed.ts\",\"// Auto-generated from schema-v0.2.6.sql - DO NOT EDIT\\n// Regenerate: npm run generate:schema\\n// Canonical checksum: \"+c+\"\\n\\nexport const SCHEMA_V_0_2_6 = \\`\"+sql.replace(/\\`/g,\"\\\\\\`\")+\"\\`;\\nexport const SCHEMA_CHECKSUM = \\\"\"+c+\"\\\";\\n\");console.log(\"Generated, checksum:\"+c);\"",
    "typecheck:dev2-compat": "echo \"Dev 2 compatibility check requires types from dev2/orchestration-contract-domain (SHA ffff758). Run with: tsc -p tsconfig.dev2-compat.json\" && tsc -p tsconfig.dev2-compat.json --noEmit 2>&1 | head -5",
    "test:orchestration:framework": "bun test tests/orchestration/compliance tests/orchestration/harness tests/orchestration/fake tests/orchestration/runtime.test.ts",
    "test:orchestration:matrix": "node scripts/generate-orchestration-compliance.mjs",
    "test:orchestration:compliance": "node scripts/generate-orchestration-compliance.mjs",
    "test:orchestration:port-discovery": "bun test tests/orchestration/compliance/port-discovery.test.ts",
    "test:orchestration:negative": "bun test tests/orchestration/negative",
    "test:orchestration:replay": "bun test tests/orchestration/replay",
    "test:orchestration:concurrency": "bun test tests/orchestration/concurrency",
    "test:orchestration:faults": "bun test tests/orchestration/fault",
    "test:orchestration:fault-injection": "bun test tests/orchestration/fault",
    "test:orchestration:integration": "node scripts/orchestration/run-integration-matrix.mjs",
    "test:orchestration:integration:all": "node scripts/orchestration/run-integration-matrix.mjs --profile all",
    "verify:orchestration:schema": "bun run scripts/orchestration/verify-schema.mjs",
    "validate:orchestration:artifacts": "node scripts/orchestration/validate-artifacts.mjs",
    "report:orchestration:compatibility": "node scripts/generate-orchestration-compliance.mjs",
    "report:orchestration:provenance": "node scripts/generate-orchestration-provenance.mjs",
    "report:orchestration:repair-handoff": "node scripts/orchestration/generate-repair-handoff.mjs",
    "report:self-host": "bun run scripts/self-host-report.mjs",
    "test:orchestration:all": "npm run test:orchestration:framework && npm run test:orchestration:matrix && npm run test:orchestration:port-discovery && npm run test:orchestration:negative && npm run test:orchestration:replay && npm run test:orchestration:concurrency && npm run test:orchestration:faults && npm run test:orchestration:integration && npm run verify:orchestration:schema",
    "benchmark:flowdeck": "bun run scripts/benchmark-flowdeck.ts",
    "benchmark:context": "bun run scripts/benchmark-context.ts",
    "benchmark:orchestration": "bun run scripts/benchmark-orchestration.ts"
  },
  "keywords": [
    "opencode",
    "multi-agent",
    "orchestration",
    "workflow",
    "governance",
    "code-intelligence",
    "ci-repair",
    "automation",
    "fdx",
    "plugin"
  ],
  "author": "Heidi Dang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heidi-dang/FlowDeck.git"
  },
  "bugs": {
    "url": "https://github.com/heidi-dang/FlowDeck/issues"
  },
  "homepage": "https://github.com/heidi-dang/FlowDeck#readme",
  "funding": "https://github.com/sponsors/heidi-dang",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "flowdeckFdxCompatibility": {
    "required": "^0.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "opencode": ">=1.4.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.3",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "axe-core": "^4.12.1",
    "bun-types": "^1.3.14",
    "ejs": "^6.0.1",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@opencode-ai/sdk": "^1.17.3"
  }
}
